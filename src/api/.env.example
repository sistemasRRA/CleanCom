# Variables del API. En desarrollo usa dotnet user-secrets (mismas claves con ":" en lugar de "__").
# En el VPS se definen como variables de entorno del servicio. Nunca subas valores reales.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Database=cleancom;User Id=cleancom_app;Password=;TrustServerCertificate=True;

# Llave de firma de los JWT, al menos 32 caracteres aleatorios.
Jwt__Llave=
Jwt__MinutosAcceso=30
Jwt__DiasRenovacion=14

# Primer usuario de Administración; solo se usa si no existe ninguno. Cambia su contraseña al entrar.
Semilla__Admin__Usuario=
Semilla__Admin__Contrasena=
