# API variables. In development use dotnet user-secrets (same keys with ":" instead of "__").
# On the VPS they are the service's environment variables. Never commit real values.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Database=cleancom;User Id=cleancom_app;Password=;TrustServerCertificate=True;

# JWT signing key, at least 32 random characters.
Jwt__Key=
Jwt__AccessMinutes=30
Jwt__RefreshDays=14

# Origins allowed to call the API from a browser (the office web). One per index.
Cors__Origins__0=https://oficina.<dominio>

# First Administracion user; only used when none exists. The password is changed on first sign-in.
Seed__Admin__UserName=
Seed__Admin__Password=
