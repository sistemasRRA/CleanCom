{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Emisor": "cleancom-api",
    "Audiencia": "cleancom-clientes",
    "Llave": "",
    "MinutosAcceso": 30,
    "DiasRenovacion": 14
  },
  "Semilla": {
    "Admin": {
      "Usuario": "",
      "NombreCompleto": "Administración",
      "Contrasena": ""
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cleancom-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
