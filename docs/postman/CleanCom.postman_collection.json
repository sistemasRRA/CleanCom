            "url": { "raw": "{{baseUrl}}/motivos", "host": ["{{baseUrl}}"], "path": ["motivos"] },
            "description": "Tipos: FailedEntrega, PlantaDelay, ContactResult."
          }
        },
        {
          "name": "2.15 · Motivos de no entrega",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/motivos?type=FailedEntrega",
              "host": ["{{baseUrl}}"],
              "path": ["motivos"],
              "query": [{ "key": "type", "value": "FailedEntrega" }]
            }
          }
        },
        {
          "name": "2.16 · Marcar día inhábil (escribe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha futura distinta en cada corrida para no chocar con la anterior.",
                  "const d = new Date(Date.UTC(2030, 0, 1) + (Number(pm.collectionVariables.get('suffix')) % 3000) * 86400000);",
                  "pm.collectionVariables.set('nonWorkingDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('nonWorkingDayId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"{{nonWorkingDate}}\",\n  \"reason\": \"Prueba Postman\"\n}" },
            "url": { "raw": "{{baseUrl}}/dias-inhabiles", "host": ["{{baseUrl}}"], "path": ["dias-inhabiles"] }
          }
        },
        {
          "name": "2.17 · Quitar día inhábil (escribe)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }
          ],
          "request": {
