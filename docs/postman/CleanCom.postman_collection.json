        {
          "name": "2.16 · Marcar día inhábil (escribe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha futura distinta en cada corrida para no chocar con la anterior.",
                  "const d = new Date(Date.UTC(2030, 0, 1) + (Number(pm.collectionVariables.get('sufijo')) % 3000) * 86400000);",
                  "pm.collectionVariables.set('fechaInhabil', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('diaInhabilId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
